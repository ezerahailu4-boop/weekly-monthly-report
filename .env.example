# ==============================================================================
# YETAF HOLDING — Directive & Report Follow-up System
# Environment Variable Template (.env.example)
# Copy to .env.local for local development or set in Vercel Project Settings.
# ==============================================================================

# Database — Neon Serverless PostgreSQL
# Format: postgresql://[user]:[password]@[endpoint-pooler].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Application Session Security — generate with `openssl rand -hex 32`
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_string

# Scheduled Automation / Cron Secret — Bearer token for /api/cron/* endpoints
CRON_SECRET=replace_with_a_secure_random_cron_bearer_token

# ERP Integration Secret — Bearer token for /api/erp/v1/* ingest and export
ERP_API_KEY=replace_with_a_secure_random_erp_bearer_token

# AI Directive Summarization — Google Gemini API Key
GEMINI_API_KEY=

# Telegram Governance Bot (Optional: can also be configured dynamically in Admin Console)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Public Application URL (e.g., https://yetaf-weekly-monthly-report.vercel.app or http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Initial Seed Passwords (used only during initial database setup; do NOT commit real values)
# If left blank, migration scripts generate cryptographically strong random passwords and print once to stdout.
CEO_SEED_PASSWORD=
ADMIN_SEED_PASSWORD=
STAFF_SEED_PASSWORD=
